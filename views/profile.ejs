<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile | NexEvent</title>

    <style>
        body {
            background-color: #0f172a;
            margin: 0;
            font-family: Arial, sans-serif;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 50px 20px;
        }

        .profile-card {
            background: white;
            border-radius: 20px;
            padding: 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            transition: all 0.3s ease;
        }

        .profile-card:hover {
            /* transform: translateY(-5px); */
            box-shadow: 0 0 25px rgba(37, 99, 235, 0.25);
        }

        .profile-avatar {
            width: 90px;
            height: 90px;
            background: #2563eb;
            color: white;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 2rem;
        }

        .profile-info {
            flex: 1;
        }

        .profile-info h2 {
            margin: 0 0 5px 0;
        }

        .profile-info p {
            color: gray;
            margin: 0 0 10px 0;
        }

        .role-badge {
            background: #dbeafe;
            color: #2563eb;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .edit-btn {
            background: #2563eb;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 12px;
            cursor: pointer;
            transition: 0.3s;
        }

        .edit-btn:hover {
            box-shadow: 0 0 25px rgba(37, 99, 235, 0.25);
        }

        .stats-section{
            margin-top: 30px;
            display: flex;
            gap: 20px;
        }

        .stat-card{
            flex: 1;
            background: white;
            border-radius: 20px;
            padding: 25px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .stat-card:hover{
            /* transform: translateY(-5px); */
            box-shadow: 0 0 20px rgba(37, 99, 235, 0.25);
        }

        .stat-card h3{
            color: #2563eb;
            font-size: 2rem;
            margin-bottom: 8px;
        }

        .stat-card p{
            color: #555;
            margin: 0;
        }

        .upcoming-events{
            margin-top: 40px;
        }

        .section-title{
            color: white;
            margin-bottom: 20px;
        }

        .event-card{
            background: white;
            border-radius: 20px;
            padding: 20px;
            margin-bottom: 15px;
            transition: all 0.3s ease;
        }

        .event-card:hover{
            /* transform: translateY(-5px); */
            box-shadow: 0 0 20px rgba(37, 99, 235, 0.25);
        }

        .event-card h4{
            margin-bottom: 10px;
        }

        .event-card p{
            margin: 5px 0;
            color: #555;
        }

        .recent-activity{
            margin-top: 40px;
        }

        .activity-card{
            background: white;
            border-radius: 20px;
            padding: 18px 20px;
            margin-bottom: 12px;
            transition: all 0.3s ease;
        }

        .activity-card:hover{
            /* transform: translateY(-5px); */
            box-shadow: 0 0 20px rgba(37, 99, 235, 0.25);
        }

        .account-settings{
            margin-top: 40px;
            margin-bottom: 50px;
        }

        .settings-card{
            background: white;
            border-radius: 20px;
            padding: 25px;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .setting-btn{
            background: #2563eb;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .setting-btn:hover{
            transform: translateY(-3px);
        }

        .logout-btn{
            background: #dc2626;
        }

    </style>
</head>
<body>

    <div class="container">

        <div class="profile-card">

            <div class="profile-avatar">
                <i class="fa-solid fa-user"></i>
            </div>
            <div class="profile-info">
                <h2>Niladri Ghosh</h2>
                <p>niladri@email.com</p>
                <span class="role-badge">Event Enthusiast</span>
            </div>
            <button class="edit-btn">
                Edit Profile
            </button>

        </div>

        <div class="stats-section">

            <div class="stat-card">
                <h3>12</h3>
                <p>Events Joined</p>
            </div>
            <div class="stat-card">
                <h3>3</h3>
                <p>Events Created</p>
            </div>
            <div class="stat-card">
                <h3>5</h3>
                <p>Upcoming Events</p>
            </div>

        </div>

        <div class="upcoming-events">

            <h2 class="section-title">Upcoming Events</h2>
            <div class="event-card">
                <h4>Tech Conference 2026</h4>
                <p>📅 15 June 2026</p>
                <p>📍 Kolkata</p>
            </div>
            <div class="event-card">
                <h4>Startup Meetup</h4>
                <p>📅 28 June 2026</p>
                <p>📍 Bengaluru</p>
            </div>

        </div>

        <div class="recent-activity">

            <h2 class="section-title">Recent Activity</h2>

            <div class="activity-card">
                <p>✅ Joined AI Workshop</p>
            </div>

            <div class="activity-card">
                <p>🎯 Registered for Hackathon 2026</p>
            </div>

            <div class="activity-card">
                <p>👤 Updated Profile Information</p>
            </div>

        </div>

        <div class="account-settings">

            <h2 class="section-title">Account Settings</h2>

            <div class="settings-card">
                <button class="setting-btn">
                    Change Password
                </button>

                <button class="setting-btn">
                    Notification Preferences
                </button>

                <button class="setting-btn logout-btn">
                    Logout
                </button>
            </div>

        </div>

    </div>

</body>
</html>